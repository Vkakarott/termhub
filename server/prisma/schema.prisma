// Prisma 7: a URL do banco fica em prisma.config.ts (migrations) e no adapter (runtime).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  member
}

enum MachineType {
  local
  ssh
}

enum ProjectStatus {
  active
  paused
  archived
}

model User {
  id           String    @id
  email        String    @unique
  name         String
  avatarUrl    String?   @map("avatar_url")
  passwordHash String?   @map("password_hash")
  googleId     String?   @unique @map("google_id")
  role         UserRole  @default(member)
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Código de login por e-mail (OTP). Só o hash é armazenado.
model LoginCode {
  id        String    @id
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_codes")
}

/// Rate limit / lockout progressivo (chave "email:<e-mail>" ou "ip:<ip>").
model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@map("login_attempts")
}

model Machine {
  id        String      @id
  name      String
  host      String?
  sshUser   String?     @map("ssh_user")
  sshPort   Int         @default(22) @map("ssh_port")
  type      MachineType
  /// Detectado no status: "macos" | "linux" | ... e ferramentas disponíveis (claude, gh, xcode, ...)
  os           String?
  capabilities Json      @default("[]")
  checkedAt    DateTime? @map("checked_at")
  createdAt DateTime    @default(now()) @map("created_at")
  projects  Project[]

  @@map("machines")
}

model Project {
  id             String        @id
  machineId      String        @map("machine_id")
  name           String
  cwd            String
  status         ProjectStatus @default(active)
  description    String?
  lastTerminalAt DateTime?     @map("last_terminal_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  machine        Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  tabs           Tab[]
  tasks          Task[]
  note           Note?
  setup          ProjectSetup?

  @@index([machineId])
  @@map("projects")
}

model Tab {
  id          String   @id
  projectId   String   @map("project_id")
  name        String
  tmuxSession String   @unique @map("tmux_session")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tabs")
}

enum TaskStatus {
  todo
  doing
  done
}

model Task {
  id          String     @id
  projectId   String     @map("project_id")
  title       String
  description String?
  status      TaskStatus @default(todo)
  position    Int        @default(0)
  /// Reservado para integrações (GitHub/Jira/Linear): { provider, id, url, ... }
  externalRef Json?      @map("external_ref")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// chave estável do ticket externo ("linear:<id>", "jira:<key>") para upsert no sync
  externalKey String?    @map("external_key")

  @@unique([projectId, externalKey])
  @@index([projectId, status, position])
  @@map("tasks")
}

model Note {
  id        String   @id
  projectId String   @unique @map("project_id")
  content   String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("notes")
}

enum IntegrationProvider {
  github
  linear
  jira
}

/// Credenciais de serviços externos (nível conta). `secret` é criptografado (AES-256-GCM).
model Integration {
  id        String              @id
  provider  IntegrationProvider
  name      String
  /// Dados não sensíveis (ex.: Jira: { baseUrl, email }; GitHub: { login })
  config    Json                @default("{}")
  secret    String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")

  @@map("integrations")
}

/// Setup do projeto: repositório, fonte de tickets, runner, agente, verificação, aprovações.
/// Guardado como JSON versionado e validado no servidor (zod) — evita uma migration por campo.
model ProjectSetup {
  projectId String   @id @map("project_id")
  version   Int      @default(1)
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_setups")
}
