# termhub.dev vhost, rendered by deploy/blue-green.sh: the upstream host below
# is swapped for the active color's container (e.g. termhub-app-blue).
server {
    listen 80;
    server_name termhub.dev www.termhub.dev;
    location / {
        proxy_pass http://__APP_HOST__:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # WebSocket dos terminais
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 20m;
    }
}
