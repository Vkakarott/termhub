# termhub.dev — reverse proxy vhost, rendered by deploy/blue-green.sh
# (replaces __APP_HOST__ with the active color's container name, e.g. termhub-app-blue).
# Path: Cloudflare Tunnel "jarvis" -> proxy-nginx:80 -> this vhost -> app container.
server {
    listen 80;
    server_name termhub.dev;

    location / {
        proxy_pass http://__APP_HOST__:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade (terminal sessions)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Terminal sessions are long-lived; don't let nginx time them out.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
