// Prisma 7: a URL do banco fica em prisma.config.ts (migrations) e no adapter (runtime).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  member
}

enum MachineType {
  local
  ssh
}

enum ProjectStatus {
  active
  paused
  archived
}

enum TabKind {
  terminal
  simulator
}

model User {
  id           String    @id
  email        String    @unique
  name         String
  avatarUrl    String?   @map("avatar_url")
  passwordHash String?   @map("password_hash")
  googleId     String?   @unique @map("google_id")
  /// DEPRECATED: replaced by roleId (kept one release for the blue/green window; drop next)
  role         UserRole  @default(member)
  roleId       String?   @map("role_id")
  roleRef      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@index([roleId])
  @@map("users")
}

/// Role = a named set of permissions. isAdmin bypasses every check; isSystem cannot be deleted.
model Role {
  id          String       @id
  name        String       @unique
  label       String
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  isAdmin     Boolean      @default(false) @map("is_admin")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")
  users       User[]
  permissions Permission[]

  @@map("roles")
}

/// One (resource, action) grant for a role. Resources and actions are a fixed catalog in code.
model Permission {
  id       String @id
  resource String
  action   String
  roleId   String @map("role_id")
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([resource, action, roleId])
  @@map("permissions")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Código de login por e-mail (OTP). Só o hash é armazenado.
model LoginCode {
  id        String    @id
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_codes")
}

/// Rate limit / lockout progressivo (chave "email:<e-mail>" ou "ip:<ip>").
model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@map("login_attempts")
}

model Machine {
  id        String      @id
  name      String
  host      String?
  sshUser   String?     @map("ssh_user")
  sshPort   Int         @default(22) @map("ssh_port")
  type      MachineType
  /// Detectado no status: "macos" | "linux" | ... e ferramentas disponíveis (claude, gh, xcode, ...)
  os           String?
  capabilities Json      @default("[]")
  checkedAt    DateTime? @map("checked_at")
  createdAt DateTime    @default(now()) @map("created_at")
  projects   Project[]
  aiAccounts AiAccount[]

  @@map("machines")
}

model Project {
  id             String        @id
  machineId      String        @map("machine_id")
  name           String
  cwd            String
  status         ProjectStatus @default(active)
  description    String?
  lastTerminalAt DateTime?     @map("last_terminal_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  machine        Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  tabs           Tab[]
  tasks          Task[]
  note           Note?
  setup          ProjectSetup?
  tickets        Ticket[]

  @@index([machineId])
  @@map("projects")
}

model Tab {
  id            String   @id
  projectId     String   @map("project_id")
  name          String
  kind          TabKind  @default(terminal)
  tmuxSession   String?  @unique @map("tmux_session")
  simulatorUdid String?  @map("simulator_udid")
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         Task[]

  @@index([projectId])
  @@map("tabs")
}

/// Tickets sincronizados das integrações (staging). Só viram task quando o usuário manda pro backlog.
model Ticket {
  id            String              @id
  projectId     String              @map("project_id")
  integrationId String              @map("integration_id")
  provider      IntegrationProvider
  /// "linear:<id>" | "jira:<KEY>" | "github:<owner/repo>#<n>"
  externalKey   String              @map("external_key")
  identifier    String
  title         String
  description   String?
  url           String
  /// estado bruto no provedor e o status mapeado
  state         String
  status        TaskStatus
  meta          Json                @default("{}")
  /// task criada a partir deste ticket (null = ainda não importado)
  taskId        String?             @unique @map("task_id")
  syncedAt      DateTime            @default(now()) @map("synced_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalKey])
  @@index([projectId, integrationId])
  @@map("tickets")
}

enum TaskStatus {
  backlog
  todo
  doing
  done
}

model Task {
  id          String     @id
  projectId   String     @map("project_id")
  title       String
  description String?
  status      TaskStatus @default(todo)
  position    Int        @default(0)
  /// Reservado para integrações (GitHub/Jira/Linear): { provider, id, url, ... }
  externalRef Json?      @map("external_ref")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// chave estável do ticket externo ("linear:<id>", "jira:<key>") para upsert no sync
  externalKey String?    @map("external_key")
  /// tab de terminal onde a task está sendo executada (run ou aberta manualmente)
  tabId       String?    @map("tab_id")
  tab         Tab?       @relation(fields: [tabId], references: [id], onDelete: SetNull)

  @@unique([projectId, externalKey])
  @@index([projectId, status, position])
  @@map("tasks")
}

model Note {
  id        String   @id
  projectId String   @unique @map("project_id")
  content   String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("notes")
}

enum IntegrationProvider {
  github
  linear
  jira
}

/// Credenciais de serviços externos (nível conta). `secret` é criptografado (AES-256-GCM).
model Integration {
  id        String              @id
  provider  IntegrationProvider
  name      String
  /// Dados não sensíveis (ex.: Jira: { baseUrl, email }; GitHub: { login })
  config    Json                @default("{}")
  secret    String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")

  @@map("integrations")
}

/// Setup do projeto: repositório, fonte de tickets, runner, agente, verificação, aprovações.
/// Guardado como JSON versionado e validado no servidor (zod) — evita uma migration por campo.
model ProjectSetup {
  projectId String   @id @map("project_id")
  version   Int      @default(1)
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_setups")
}

enum AiProvider {
  claude
  chatgpt
  gemini
  antigravity
}

/// AI subscription account whose usage limits are shown on the home page.
/// No token is stored: the CLI credential is read from the machine on demand
/// (Claude Code, Codex CLI, Gemini CLI or Antigravity CLI login) and never persisted or logged.
model AiAccount {
  id        String     @id
  provider  AiProvider
  label     String
  machineId String     @map("machine_id")
  /// CLI config dir override (e.g. ~/.claude-work for a second Claude login). null = default.
  configDir String?    @map("config_dir")
  createdAt DateTime   @default(now()) @map("created_at")
  machine   Machine    @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@map("ai_accounts")
}

/// Cloud waitlist sign-ups from the landing page (public form). Managed from the app.
model WaitlistEntry {
  id           String   @id
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  /// country calling code without "+", e.g. "55"
  phoneCountry String   @map("phone_country")
  /// area code, e.g. "62"
  phoneArea    String   @map("phone_area")
  phoneNumber  String   @map("phone_number")
  /// normalized E.164, e.g. "+5562999999999"
  phone        String
  linkedin     String?
  github       String?
  /// "pt" | "en": language the form was filled in
  locale       String   @default("pt")
  source       String   @default("landing")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("waitlist_entries")
}
