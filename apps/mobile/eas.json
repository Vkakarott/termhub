{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_MODE": "mock",
        "EXPO_PUBLIC_TERMHUB_URL": "https://termhub.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_MODE": "http",
        "EXPO_PUBLIC_TERMHUB_URL": "https://termhub.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
