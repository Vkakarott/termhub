# Which API the app talks to (design spec §2): `mock` runs entirely in memory, inside the app,
# with no network and no server — this is the default even with this file absent, so plain
# `npm start` already runs in mock mode. Set `http` once the server exists, to talk to a real one
# through EXPO_PUBLIC_TERMHUB_URL below (see apps/mobile/README.md, "Switching to a real server").
EXPO_PUBLIC_API_MODE=mock

# Server the app talks to in `http` mode. Production builds bake https://termhub.dev in through
# eas.json; this file only matters for `expo start` against a local or staging server.
# The mobile API lives on the host without Cloudflare Access (spec §12.1).
EXPO_PUBLIC_TERMHUB_URL=http://localhost:3000
