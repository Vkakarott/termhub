# Which API the app talks to (design spec §2). `http` talks to the real server at
# EXPO_PUBLIC_TERMHUB_URL below. `mock` runs entirely in memory, inside the app, with no network
# and no server (the simulator with nothing to talk to); it is also what the code falls back to
# when this file is absent. See apps/mobile/README.md, "Against the real server".
EXPO_PUBLIC_API_MODE=http

# Server the app talks to in `http` mode. The mobile API lives on the host without Cloudflare
# Access (spec §12.1); point it at a local or staging server to test one.
EXPO_PUBLIC_TERMHUB_URL=https://termhub.dev
