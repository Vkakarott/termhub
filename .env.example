# ===== termhub =====
# Copie para .env e ajuste. O servidor lê este arquivo a partir de /server (ou da raiz).

NODE_ENV=development
PORT=3000
# Em produção mantenha 127.0.0.1 (acesso externo só via Cloudflare Tunnel)
HOST=127.0.0.1

# Onde fica o banco SQLite (termhub.db). Padrão: <raiz>/data
# DATA_DIR=/Volumes/Extra/projects/8020/termhub/data

# URL pública usada em redirects do OAuth e no cookie "secure".
# Dev: http://localhost:5173 (Vite) | Prod via tunnel: https://termhub.seudominio.com
PUBLIC_URL=http://localhost:5173

# ----- Autenticação -----
# app        -> login por e-mail/senha (+ Google opcional) com cookie de sessão
# cloudflare -> valida o JWT do Cloudflare Access (header Cf-Access-Jwt-Assertion)
# disabled   -> SEM autenticação (apenas dev local!)
# Pode combinar "app,cloudflare" para defesa em camadas.
AUTH_MODE=app
SESSION_TTL_DAYS=30
# true | false | auto (auto = true se PUBLIC_URL for https)
COOKIE_SECURE=auto

# Google OAuth (opcional). Redirect URI autorizado: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Access (obrigatório se AUTH_MODE incluir "cloudflare")
# CF_TEAM_DOMAIN=https://seutime.cloudflareaccess.com
# CF_AUD=<Application Audience (AUD) Tag do app no Zero Trust>

# ----- Terminais -----
# Shell padrão dentro do tmux local (padrão: $SHELL)
# LOCAL_SHELL=/bin/zsh
# Caminho do tmux (útil quando roda como serviço com PATH mínimo)
# TMUX_PATH=/opt/homebrew/bin/tmux
